{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8099"],
      "port": 8099,
      "autoPort": false
    },
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "calmcarry-preview", "-l", "8090"],
      "port": 8090
    }
  ]
}
