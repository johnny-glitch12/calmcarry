# CalmCarry app (Expo) — build-time public env. Copy to `.env` and fill for prod.
# Only EXPO_PUBLIC_* vars are exposed to the client (never put secrets here).

# Backend API the app talks to (defaults to http://localhost:4000 in dev)
EXPO_PUBLIC_API_BASE=https://calmcarry-api.fly.dev

# Google OAuth client ids (Google Cloud Console). Until these are set, the
# "Continue with Google" button stays hidden. Apple Sign-In needs no key here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Crash/error monitoring (Sentry). No DSN → monitoring stays off (no reporting).
EXPO_PUBLIC_SENTRY_DSN=

# IAP product ids are placeholders in src/lib/iap.native.ts — create matching
# subscriptions in App Store Connect / Play Console:
#   calmcarry.premium.monthly , calmcarry.premium.annual
