# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# store-submission + push credentials (founder drops these in; NEVER commit real ones)
/secrets/
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files - never commit real secrets (but keep .env.example tracked)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# local SQLite databases (may contain user data / seeded creds)
**/data/*.sqlite
**/data/*.sqlite-journal
**/data/*.sqlite-wal
**/data/*.sqlite-shm

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# claude code (local only)
.claude/settings.local.json

# Vercel preview build output
calmcarry-preview/

# Vercel local link
.vercel

# scratch output from scripts/gen-voices.mjs + gen-narrations.mjs (bundled copies live in assets/audio)
voice-out/
narration-out/

# agent tooling - not part of the product repo
.claude/
claude-memory/
