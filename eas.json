{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "device": {
      "extends": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://calmcarry-api-production.up.railway.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://calmcarry-api-production.up.railway.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "_COMMENT_SUBSCRIPTION_GROUP": "Set EXPO_PUBLIC_IOS_SUBSCRIPTION_GROUP to the App Store Connect subscription-group id once the subscriptions exist. Until it is set, the 3-day trial is NOT advertised (fail-safe against over-promising). Get the numeric id from App Store Connect > Monetization > Subscriptions > (your group).",
        "EXPO_PUBLIC_IOS_SUBSCRIPTION_GROUP": ""
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6796861173",
        "appleTeamId": "NTTDKF8D29"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
