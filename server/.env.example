# CalmCarry API — environment.
# Copy to `.env` and fill in. EVERYTHING runs without these (dev-fallback mode);
# add real values for production. Never commit the real .env.
# Production deploy = Fly.io: set these with `fly secrets set KEY=value` (see DEPLOY.md).

# --- core ---
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Postgres in production (leave blank to use the local SQLite file).
# Neon shape: postgresql://user:pass@host/db?sslmode=require&channel_binding=require
DATABASE_URL=
DATABASE_SSL=true                  # verified TLS to Postgres; only set false for a local non-TLS PG
DB_PATH=                           # local SQLite path override (default: ./data/calmcarry.sqlite)
# Comma-separated allowed web origins (REQUIRED in production)
CORS_ORIGINS=

# --- Apple (Sign in with Apple + App Store IAP receipt validation) ---
APPLE_BUNDLE_ID=co.theglowcompany.calmcarry
APPLE_SIGNIN_CLIENT_ID=            # Services ID / bundle id for Sign in with Apple
APPLE_TEAM_ID=                     # developer team id (Sign in with Apple token exchange)
APPLE_SIGNIN_KEY_ID=               # Sign in with Apple key id
APPLE_SIGNIN_KEY_P8=               # contents of the Sign-in AuthKey .p8 (\n-escaped ok)
APPLE_IAP_SHARED_SECRET=           # App Store Connect > App > App-Specific Shared Secret
APPLE_APP_APPLE_ID=                # numeric App Store app id (App Store Server API online checks)
APPLE_ROOT_CERTS_DIR=              # dir of Apple Root CA certs; in the Docker image: /app/certs/apple

# Premium subscription SKUs — a validated receipt only grants premium if its
# product_id is in this allowlist (defends against arbitrary-product receipts).
PREMIUM_PRODUCT_IDS=calmcarry.premium.monthly,calmcarry.premium.annual

# --- Google (Sign in with Google + Play Billing validation) ---
GOOGLE_PLAY_PACKAGE=co.theglowcompany.calmcarry
GOOGLE_SIGNIN_CLIENT_ID=           # OAuth web client id
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=  # service-account JSON (Play Developer API), base64 or raw
# Play RTDN webhook (Pub/Sub push with OIDC auth) — both required or the
# /webhooks/google endpoint stays fail-closed (503):
GOOGLE_PUBSUB_AUDIENCE=            # expected `aud` claim — usually the push endpoint URL
GOOGLE_PUBSUB_SA_EMAIL=            # expected `email` claim — the push subscription's service account

# --- Shopify (ownership match by purchase email + order webhooks) ---
SHOPIFY_SHOP=                      # e.g. theglowcompany.myshopify.com
SHOPIFY_ADMIN_TOKEN=               # Admin API access token (read_orders)
SHOPIFY_WEBHOOK_SECRET=            # webhook HMAC secret
SHOPIFY_BUNDLE_PRODUCT_IDS=        # comma-separated product/variant ids that grant premium

# --- Content CDN (post-v1: signed URLs for streamed audio/video) ---
# v1 ships all audio bundled in the app binary — leave STREAMING_ENABLED unset.
# With STREAMING_ENABLED=true, both CDN vars are REQUIRED (prod refuses to boot without them).
STREAMING_ENABLED=
CDN_BASE_URL=                      # e.g. https://cdn.theglowcompany.co
CDN_SIGNING_KEY=                   # HMAC key used to sign asset URLs
CDN_SIGNED_URL_TTL=3600

# --- Push (APNs + FCM) ---
# NOTE: server-side send is still a logged no-op (push.service.ts) — needs FCM HTTP v1 / APNs code.
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=                       # contents of the AuthKey_XXXX.p8

# --- CMS publishing (guards POST /admin/content) ---
CMS_ADMIN_KEY=dev-cms-key

# --- Retention cron ---
# A GitHub Actions cron (.github/workflows/retention-purge.yml) calls
# /retention/purge daily with `Authorization: Bearer ${CRON_SECRET}`. Set the
# same value here (Fly secret) AND as the CRON_SECRET GitHub repo secret, or
# the daily COPPA/retention purge will 401 and never run.
CRON_SECRET=

# --- Error monitoring ---
SENTRY_DSN=                        # Sentry Node project DSN; blank = off (strict no-op)

# --- Rate-limit storage (optional) ---
# Unset → in-memory, per-instance counters. Fine for the single always-on Fly
# machine. Before scaling to a 2nd machine, set a shared store (REDIS_URL +
# @nest-lab/throttler-storage-redis) so the rate limits hold across machines.
REDIS_URL=
